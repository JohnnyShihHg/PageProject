{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "member",
  "compatibility_date": "2026-08-02",
  "main": "./worker/index.js",
  // Cloudflare Access 的設定值（見 worker/access.js）。兩個都不是機密 ——
  // AUD 單獨存在時無法拿來繞過任何驗證，team domain 本來就會出現在登入導向網址上，
  // 所以直接寫在這裡進版控就好，不用當 secret 處理。
  //
  // 2026-08-06 填入：Johnny 在 Dashboard 建立的 Access Application「my-page-photo」，
  // Policy 只允許 johnny.shih1997@gmail.com，Session Duration 24 小時。
  // 已用 curl 驗證邊緣層真的在擋（沒帶憑證回 302 導去登入頁）。
  // Team domain 後來從自動產生的 flat-sea-f0d2 改成 mypagephoto，AUD 不受影響
  // （AUD 綁的是 Application 本身，不是 team domain）。
  "vars": {
    "ACCESS_TEAM_DOMAIN": "mypagephoto.cloudflareaccess.com",
    "ACCESS_AUD": "625d7989eddd5413753b052a049df94a00c16361110ef4bbffb384316310206d"
  },
  // Worker 對 Worker 的呼叫必須走 Service Binding，不能用全域 fetch() ——
  // 兩支 Worker 在同一個 zone，用 fetch() 會被 Cloudflare 擋下回 error 1042。
  // 詳細原因見 worker/index.js 的 proxyToApi。
  //
  // 本機開發不受影響：`.dev.vars` 的 PAGEWORKER_URL 指向 127.0.0.1:8791，
  // 程式碼在有那個值時走 HTTP，不會用到這個 binding。
  "services": [
    {
      "binding": "PAGEWORKER",
      "service": "pageworker"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 與公開站相同：不用 "single-page-application"，那會讓任何不存在的網址都回
    // HTTP 200 且 Worker 根本不會被呼叫。設 "none" 才能由 worker/index.js
    // 依 src/router/paths.js 判斷是否為合法路由。
    "not_found_handling": "none"
  }
}
