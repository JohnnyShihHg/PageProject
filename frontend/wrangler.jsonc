{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pageproject",
  "compatibility_date": "2026-08-02",
  "main": "./worker/index.js",
  // 自訂網域。只在 `wrangler deploy`（master → production）生效，dev 分支走
  // `wrangler versions upload --preview-alias dev` 不會動到路由/網域綁定，
  // 所以 dev 預覽站不受影響，仍然只能用 dev-pageproject.pageworker.workers.dev 存取。
  // 不含 www：2026-08-07 是全新網域，還沒有人習慣打 www 進來，也沒有舊連結
  // 需要相容，先簡單處理，之後真的需要再加 www + 導轉。
  // 原本的 pageproject.pageworker.workers.dev 不會失效，兩個網址並存。
  "routes": [
    { "pattern": "zhendoku.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 刻意不是 "single-page-application"：那個設定會讓任何不存在的網址都回
    // HTTP 200 + 首頁 HTML（soft 404），而且 Worker 根本不會被呼叫。
    // 改成 "none" 之後，找不到檔案的請求才會落到 worker/index.js 判斷是否為
    // 合法路由。實際存在的靜態檔（圖、JS、CSS）仍由資產層直接送，不進 Worker。
    "not_found_handling": "none"
  }
}
